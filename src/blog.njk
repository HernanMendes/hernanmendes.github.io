---
layout: layout.njk
lang: es
title: Blog — Hernan Mendes
description: Articulos y notas sobre Python, scraping y data pipelines.
permalink: /blog/
---

<section class="blog">
  <div class="blog-header">
    <div>
      <p class="hero-tag">// Blog</p>
      <h1>Blog</h1>
      <p class="hero-subtitle">Notas sobre Python, scraping y data pipelines.</p>
    </div>
    <div class="blog-actions" data-mobile-nav>
      <a class="lang-toggle" href="/en/blog/" aria-label="{{ site.ui.langSwitchAria }}">{{ site.ui.langSwitch }}</a>
      <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" data-theme-label-light="{{ site.ui.themeToggleLight }}" data-theme-label-dark="{{ site.ui.themeToggleDark }}">
        {{ site.ui.themeToggleLight }}
      </button>
      <a class="btn btn-ghost" href="/">
        <span class="label-full">{{ site.ui.blogHome }}</span>
        <span class="label-short" aria-hidden="true">Inicio</span>
      </a>
    </div>
  </div>

  <div class="blog-list">
    {% for post in collections.blog_es %}
    <article class="blog-item">
      <p class="blog-meta">{{ post.date | dateEs }}</p>
      <h2 class="blog-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
      {% if post.data.description %}
      <p class="blog-excerpt">{{ post.data.description }}</p>
      {% endif %}
    </article>
    {% else %}
    <p class="blog-empty">Todavia no hay posts publicados.</p>
    {% endfor %}
  </div>
</section>
