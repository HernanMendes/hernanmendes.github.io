<section id="about">
  <p class="sec-label reveal">01 / about</p>
  <h2 class="sec-title reveal">Un poco sobre mí</h2>
  <div class="about-grid">
    <div class="about-text reveal">
      {% renderTemplate "md" %}{% include "../../sections/about.md" %}{% endrenderTemplate %}
    </div>
    <div class="about-details reveal">
      {% for row in site.about.details %}
      <div class="detail-row">
        <span class="detail-key">{{ row.key }}</span>
        <span class="detail-val"{% if row.accent %} style="color: var(--accent2);"{% endif %}>{{ row.value }}</span>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
