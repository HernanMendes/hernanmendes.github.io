<section id="about">
  <p class="sec-label reveal">{{ site.sections.about.label }}</p>
  <h2 class="sec-title reveal">{{ site.sections.about.title }}</h2>
  <div class="about-grid">
    <div class="about-text reveal">
      {% if lang == "en" %}
      {% renderTemplate "md" %}{% include "../../sections/about.en.md" %}{% endrenderTemplate %}
      {% else %}
      {% renderTemplate "md" %}{% include "../../sections/about.md" %}{% endrenderTemplate %}
      {% endif %}
    </div>
    <div class="about-details reveal">
      {% for row in site.about.details %}
      <div class="detail-row">
        <span class="detail-key">{{ row.key }}</span>
        <span class="detail-val"{% if row.accent %} style="color: var(--accent2);"{% endif %}>{{ row.value }}</span>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
