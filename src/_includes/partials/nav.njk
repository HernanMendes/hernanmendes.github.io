<nav>
  <div class="nav-logo">~/hernan-mendes</div>
  <div class="nav-actions">
    <ul>
      {% for item in site.nav %}
      <li><a href="{{ item.href }}">{{ item.label }}</a></li>
      {% endfor %}
    </ul>
    <a class="lang-toggle" href="{% if lang == 'en' %}/{% else %}/en/{% endif %}" aria-label="{{ site.ui.langSwitchAria }}">
      {{ site.ui.langSwitch }}
    </a>
    <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" data-theme-label-light="{{ site.ui.themeToggleLight }}" data-theme-label-dark="{{ site.ui.themeToggleDark }}">
      {{ site.ui.themeToggleLight }}
    </button>
  </div>
</nav>
