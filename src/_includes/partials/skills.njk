<section id="skills">
  <p class="sec-label reveal">{{ site.sections.skills.label }}</p>
  <h2 class="sec-title reveal">{{ site.sections.skills.title }}</h2>
  <div class="skills-grid reveal">
    {% for group in site.skills %}
    <div class="skill-card">
      <p class="skill-category">{{ group.category }}</p>
      <div class="skill-tags">
        {% for tag in group.tags %}
        <span class="tag">{{ tag }}</span>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>
</section>
