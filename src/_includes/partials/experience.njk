<section id="experience">
  <p class="sec-label reveal">{{ site.sections.experience.label }}</p>
  <h2 class="sec-title reveal">{{ site.sections.experience.title }}</h2>
  <div class="exp-list">
    {% for item in site.experience %}
    <div class="exp-item reveal">
      <div class="exp-date">{{ item.date }}</div>
      <div>
        <p class="exp-role">{{ item.role }}</p>
        <p class="exp-company">{{ item.company }}</p>
        <p class="exp-desc">{{ item.description }}</p>
        {% if item.tags %}
        <div class="exp-tags">
          {% for tag in item.tags %}
          <span class="tag">{{ tag }}</span>
          {% endfor %}
        </div>
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
</section>
